# Copy this file to .env and fill in real values, or export these as
# actual environment variables in your shell/hosting environment.
# config.php reads these with getenv(); nothing here is loaded automatically
# unless you export the variables yourself (see README for local setup).

DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=liveChat

# Leave RECAPTCHA_ENABLED=false for local development so you aren't
# blocked by Google's recaptcha service.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=465
SMTP_FROM=
